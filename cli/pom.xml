<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.noregressions.paperband</groupId>
        <artifactId>parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>cli</artifactId>
    <name>Paperband :: CLI</name>
    <description>paperband command-line tool. Bundles the renderer modules it ships with.</description>
    <url>https://github.com/noregressions/paperband</url>

    <dependencies>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>render-playwright</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>cards</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>config</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>include</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>layout</artifactId>
        </dependency>

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <!--
          Direct PDFBox dependency for PagesReport's named-destination
          extraction (playwright is now the only renderer, so there's no
          openhtmltopdf-pdfbox transitive chain to ride on anymore). Slated
          for removal once PagesReport moves to Playwright-native DOM
          measurement instead of reading the finished PDF.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>paperband-${project.version}</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.noregressions.paperband.cli.Paperband</mainClass>
                                </transformer>
                                <!-- merge META-INF/services/* so ServiceLoader finds every renderer -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <exclude>META-INF/LICENSE.txt</exclude>
                                        <exclude>META-INF/NOTICE.txt</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
