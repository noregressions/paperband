<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>${groupId}</groupId>
    <artifactId>${artifactId}</artifactId>
    <version>${version}</version>
    <!--
        pom packaging: this project has no Java sources of its own. Its only
        output is the PDF (and, optionally, the static site) that
        paperband-maven-plugin renders from guide/ at package time.
    -->
    <packaging>pom</packaging>

    <name>${project.artifactId}</name>
    <description>Guide built with Paperband (https://github.com/noregressions/paperband).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Version of dev.noregressions.paperband:paperband-maven-plugin to build with.
             Bump this independently of your own project version when a new
             Paperband release comes out. -->
        <paperband.version>${paperbandVersion}</paperband.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>dev.noregressions.paperband</groupId>
                <artifactId>paperband-maven-plugin</artifactId>
                <version>${paperband.version}</version>
                <executions>
                    <execution>
                        <id>build-guide-pdf</id>
                        <!-- Default goal phase is process-resources; moved to package here
                             so `mvn package`/`mvn install` produces the PDF as a normal
                             build artifact alongside anything else the module builds. -->
                        <phase>package</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                        <configuration>
                            <input>${project.basedir}/guide</input>
                            <output>${project.build.directory}/${project.artifactId}.pdf</output>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
