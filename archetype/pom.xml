<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.noregressions.paperband</groupId>
        <artifactId>parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>paperband-archetype</artifactId>
    <packaging>maven-archetype</packaging>
    <name>Paperband :: Archetype</name>
    <description>
        Maven archetype that scaffolds a new Paperband guide project: a pom.xml with
        paperband-maven-plugin already wired up, plus the guide/ folder Paperband
        conventions expect (a book-root paperband.yaml and a starter card).
    </description>
    <url>https://github.com/noregressions/paperband</url>

    <properties>
        <!--
            archetype-packaging (the <extensions> entry below) supplies the
            LifecycleMapping component that teaches Maven what packaging=maven-archetype
            means; maven-archetype-plugin supplies the goals (jar, integration-test,
            update-local-catalog) that lifecycle binds to phases. Both ship from the
            same Apache Maven Archetype release train and must stay in lockstep.
        -->
        <maven-archetype-plugin.version>3.4.1</maven-archetype-plugin.version>
    </properties>

    <build>
        <extensions>
            <extension>
                <groupId>org.apache.maven.archetype</groupId>
                <artifactId>archetype-packaging</artifactId>
                <version>${maven-archetype-plugin.version}</version>
            </extension>
        </extensions>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-archetype-plugin</artifactId>
                    <version>${maven-archetype-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--
                maven-javadoc-plugin (bound in the parent's "release" profile) skips
                itself here with "Not executing Javadoc as the project is not a Java
                classpath-capable package" - there's no src/main/java to document.
                But Maven Central requires a -javadoc.jar for every non-pom-packaged
                artifact, maven-archetype included (see
                https://central.sonatype.org/publish/requirements/), and won't accept
                this module without one. Standard workaround: attach an empty jar
                (classifier=javadoc) built from a placeholder directory instead of
                relying on the javadoc plugin. Left unconditional (not release-profile-
                gated) since Maven doesn't reliably merge a child profile's <build> into
                a parent profile of the same id - simpler to always attach the (tiny,
                harmless) placeholder than to depend on that.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>empty-javadoc-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>javadoc</classifier>
                            <classesDirectory>${project.basedir}/src/main/javadoc</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
