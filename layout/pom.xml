<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.noregressions.paperband</groupId>
        <artifactId>parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>layout</artifactId>
    <name>Paperband :: Layout</name>
    <description>Pebble-driven layout engine: turns a Card + RenderContext into a styled HTML page.</description>
    <url>https://github.com/noregressions/paperband</url>

    <dependencies>
        <!--
            config supplies the one reader for paperband.yaml. The layout needs
            it for a section folder's own title/landing override, which is read
            outside the per-card cascade (section grouping happens after every
            card is loaded, so no card's parent chain carries it). Depending on
            config rather than re-parsing here keeps the file format to a single
            reader. config depends only on core, so this adds no cycle.
        -->
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pebbletemplates</groupId>
            <artifactId>pebble</artifactId>
        </dependency>
        <dependency>
            <!-- Analyzers only (tokenisation, stopwords, stemming) for the
                 auto-generated index — see IndexTermExtractor. No Lucene
                 index is ever built or queried. -->
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>
</project>
