<?xml version="1.0" encoding="UTF-8"?>
<!--
    Kitchen sink: a small book that uses every major Paperband feature once,
    each marked with a comment or a line of text naming the guide card that
    explains it. See README.md for the feature-to-file map.

    Built from the repository root with the examples profile, using the plugin
    built earlier in the same run:

        mvn install -Pexamples      # target/kitchen-sink.pdf and target/site/

    Or on its own, once the root has been installed:

        mvn package
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.noregressions.paperband.examples</groupId>
        <artifactId>examples</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>kitchen-sink</artifactId>
    <!-- pom packaging: nothing to compile, the book is the only output.
         https://noregressions.github.io/paperband/cards/place-a-book.html -->
    <packaging>pom</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>dev.noregressions.paperband</groupId>
                <artifactId>paperband-maven-plugin</artifactId>
                <!-- The plugin this reactor built, not a released one. -->
                <version>${project.version}</version>
                <executions>
                    <!-- No <input> or <content>: the book is at the conventional
                         src/main/paperband, cards in content/.
                         https://noregressions.github.io/paperband/cards/start-a-new-book.html -->
                    <execution>
                        <id>pdf</id>
                        <phase>package</phase>
                        <goals><goal>build</goal></goals>
                        <configuration>
                            <output>${project.build.directory}/kitchen-sink.pdf</output>
                        </configuration>
                    </execution>
                    <!-- A second document from the same content: one card, a
                         different card body. The steps card marks one
                         paragraph per step {.instructions}; this build's
                         layouts/_card-body.html keeps only each step's title,
                         that paragraph and its command, using | select.
                         https://noregressions.github.io/paperband/cards/themes.html -->
                    <execution>
                        <id>cheatsheet</id>
                        <phase>package</phase>
                        <goals><goal>build</goal></goals>
                        <configuration>
                            <input>${project.basedir}/src/main/paperband/content/01-basics/04-steps.md</input>
                            <layouts>${project.basedir}/src/main/cheatsheet/layouts</layouts>
                            <output>${project.build.directory}/cheatsheet.pdf</output>
                        </configuration>
                    </execution>
                    <execution>
                        <id>site</id>
                        <phase>package</phase>
                        <goals><goal>site</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site</outputDirectory>
                            <clean>true</clean>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
