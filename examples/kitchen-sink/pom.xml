<?xml version="1.0" encoding="UTF-8"?>
<!--
    Kitchen sink: a small book that uses every major Paperband feature once,
    each marked with a comment or a line of text naming the guide card that
    explains it. See README.md for the feature-to-file map.

    Built from the repository root with the examples profile, using the plugin
    built earlier in the same run:

        mvn install -Pexamples      # target/kitchen-sink.pdf and target/site/

    Or on its own, once the root has been installed:

        mvn package
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.noregressions.paperband.examples</groupId>
        <artifactId>examples</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>kitchen-sink</artifactId>
    <!-- pom packaging: nothing to compile, the book is the only output.
         https://noregressions.github.io/paperband/cards/place-a-book.html -->
    <packaging>pom</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>dev.noregressions.paperband</groupId>
                <artifactId>paperband-maven-plugin</artifactId>
                <!-- The plugin this reactor built, not a released one. -->
                <version>${project.version}</version>
                <executions>
                    <!-- No <input> or <content>: the book is at the conventional
                         src/main/paperband, cards in content/.
                         https://noregressions.github.io/paperband/cards/start-a-new-book.html -->
                    <execution>
                        <id>pdf</id>
                        <phase>package</phase>
                        <goals><goal>build</goal></goals>
                        <configuration>
                            <output>${project.build.directory}/kitchen-sink.pdf</output>
                        </configuration>
                    </execution>
                    <!-- A cheat sheet of the workshop: <includes> picks that
                         folder's cards out of the book, and the cheatsheet
                         view turns each into its {!step} entries (heading,
                         the paragraph marked {.instructions}, the ```command
                         and its ```console output). The full guide above stays as it is.
                         https://noregressions.github.io/paperband/cards/make-a-cheat-sheet.html
                         The <page> after the section adds a generated page,
                         layouts/commands.html: every command, from cards | query.
                         https://noregressions.github.io/paperband/cards/maven-plugin.html#generated-pages -->
                    <execution>
                        <id>cheatsheet</id>
                        <phase>package</phase>
                        <goals><goal>build</goal></goals>
                        <configuration>
                            <book>
                                <title>Workshop cheat sheet</title>
                                <sections>
                                    <section>
                                        <!-- The folder's name as the id, so the
                                             divider keeps 04-workshop/_section.md -->
                                        <id>04-workshop</id>
                                        <title>Workshop</title>
                                        <includes>
                                            <include>04-workshop/0*.md</include>
                                        </includes>
                                    </section>
                                    <page><template>commands</template></page>
                                </sections>
                                <vars>
                                    <toc>false</toc>
                                    <index>false</index>
                                </vars>
                            </book>
                            <view>cheatsheet</view>
                            <output>${project.build.directory}/cheatsheet.pdf</output>
                        </configuration>
                    </execution>
                    <!-- A student edition: the whole book, with each {.solution}
                         (the Try It exercise in 01-basics/02-blocks.md) printed as
                         space to write the answer in.
                         https://noregressions.github.io/paperband/cards/make-a-student-edition.html -->
                    <execution>
                        <id>student</id>
                        <phase>package</phase>
                        <goals><goal>build</goal></goals>
                        <configuration>
                            <view>student</view>
                            <output>${project.build.directory}/student.pdf</output>
                        </configuration>
                    </execution>
                    <!-- The same cheat sheet as a site: a view works for the
                         site goal too, and the <page> is commands.html, with
                         an entry in the nav after the workshop. -->
                    <execution>
                        <id>cheatsheet-site</id>
                        <phase>package</phase>
                        <goals><goal>site</goal></goals>
                        <configuration>
                            <book>
                                <title>Workshop cheat sheet</title>
                                <sections>
                                    <section>
                                        <id>04-workshop</id>
                                        <title>Workshop</title>
                                        <includes>
                                            <include>04-workshop/0*.md</include>
                                        </includes>
                                    </section>
                                    <page><template>commands</template></page>
                                </sections>
                            </book>
                            <view>cheatsheet</view>
                            <outputDirectory>${project.build.directory}/cheatsheet-site</outputDirectory>
                            <clean>true</clean>
                        </configuration>
                    </execution>
                    <execution>
                        <id>site</id>
                        <phase>package</phase>
                        <goals><goal>site</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site</outputDirectory>
                            <clean>true</clean>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
