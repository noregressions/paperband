<?xml version="1.0" encoding="UTF-8"?>
<!--
    A one-card book that ports table.html: the data in content/paperband.yaml,
    the markup built from it in content/01-map.md, the look in styles/map.css.

    Built from the repository root with the examples profile, using the plugin
    built earlier in the same run:

        mvn install -Pexamples      # target/effectiveness-map.pdf and target/site/

    Or on its own, once the root has been installed:

        mvn package
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.noregressions.paperband.examples</groupId>
        <artifactId>examples</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>effectiveness-map</artifactId>
    <packaging>pom</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>dev.noregressions.paperband</groupId>
                <artifactId>paperband-maven-plugin</artifactId>
                <!-- The plugin this reactor built, not a released one. -->
                <version>${project.version}</version>
                <executions>
                    <!-- No <input> or <content>: the book is at src/main/paperband -->
                    <execution>
                        <id>pdf</id>
                        <phase>package</phase>
                        <goals><goal>build</goal></goals>
                        <configuration>
                            <output>${project.build.directory}/effectiveness-map.pdf</output>
                        </configuration>
                    </execution>
                    <execution>
                        <id>site</id>
                        <phase>package</phase>
                        <goals><goal>site</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site</outputDirectory>
                            <clean>true</clean>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
