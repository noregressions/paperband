' PlantUML styling for this book's diagrams.
'
' Named once, in the root paperband.yaml:
'
'   vars:
'     plantuml:
'       styleFile: styles/diagrams.puml
'
' It has to be a file like this rather than CSS, and that is not a paperband
' decision: PlantUML bakes every colour into the shape that carries it
' (fill="#E2E2F0", style="stroke:#181818") and emits no class attributes, so a
' stylesheet has nothing to select. PlantUML's own style language is the only
' way in.
'
' The values below are the noregressions theme's tokens, copied by hand — the
' two systems have no way to share them. When the theme's palette moves, this
' moves with it. See theme.css.
'
' Each token name sits on its own line above the value it names. PlantUML
' reads a comment after a value as part of the value: "#687280 ' --nr-muted"
' is no colour at all, and arrows drawn with it came out white.

<style>
root {
  FontName        "IBM Plex Sans"
  FontSize        12
  ' --nr-text
  FontColor       #333333
  ' --nr-line-strong
  LineColor       #aeb7c2
  BackgroundColor transparent
  ' --nr-brand
  HyperLinkColor  #1d4ed8
}

' Titles and captions sit with the book's headings, not with its prose.
title {
  FontName  "IBM Plex Sans"
  FontSize  14
  ' --nr-ink
  FontColor #161616
}

' One quiet fill for every kind of box, so a diagram reads as structure
' rather than as decoration -- the same rule the prose theme follows.
node, component, class, entity, participant, state, usecase, rectangle, artifact {
  ' --nr-surface
  BackgroundColor #f6f8fa
  LineColor       #aeb7c2
  FontColor       #161616
  RoundCorner     3
}

arrow {
  ' --nr-muted
  LineColor #687280
  FontColor #333333
  FontSize  11
}

note {
  ' --nr-info-soft
  BackgroundColor #eefafd
  ' --nr-info
  LineColor       #0e8ea9
  FontColor       #333333
  FontSize        11
}

sequenceDiagram {
  lifeLine {
    LineColor #aeb7c2
  }
  group {
    BackgroundColor transparent
    LineColor       #aeb7c2
    FontColor       #161616
  }
  divider {
    ' --nr-surface-strong
    BackgroundColor #edf1f5
    LineColor       #aeb7c2
  }
}

' Monospace wherever the diagram is quoting the machine, matching the book's
' rule that mono means "what the computer said".
stereotype {
  FontName "IBM Plex Mono"
  FontSize 10
}
</style>
