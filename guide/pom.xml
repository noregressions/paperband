<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.noregressions.paperband</groupId>
        <artifactId>parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>guide</artifactId>
    <!--
        pom packaging: this module builds documentation (PDF + static site) with
        the Paperband plugin during the package phase. It has no Java sources
        and produces no jar, so pom packaging skips the compile/test/jar steps
        (and the "JAR will be empty" warning) while still running the plugin
        executions bound to package below.
    -->
    <packaging>pom</packaging>

    <name>Paperband :: Guide</name>
    <description>
        Self-documenting guide. The guide source lives in guide/; the PDF and
        static site produced at package time ARE the documentation.
    </description>
    <url>https://github.com/noregressions/paperband</url>

    <build>
        <plugins>
            <!--
                The guide is built by the plugin, in this same reactor: the
                plugin module is ordered before this one (see the -Pguide
                profile comment in the parent pom), so `mvn install -Pguide`
                renders with the plugin it just built rather than a released
                one. Two executions, PDF then static site, from the same book
                directory.
            -->
            <plugin>
                <groupId>dev.noregressions.paperband</groupId>
                <artifactId>paperband-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>build-guide-pdf</id>
                        <phase>package</phase>
                        <goals><goal>build</goal></goals>
                        <configuration>
                            <input>${project.basedir}/guide</input>
                            <output>${project.build.directory}/guide.pdf</output>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build-guide-site</id>
                        <phase>package</phase>
                        <goals><goal>site</goal></goals>
                        <configuration>
                            <input>${project.basedir}/guide</input>
                            <outputDirectory>${project.build.directory}/guide-site</outputDirectory>
                            <clean>true</clean>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <!--
                        The guide deliberately includes real project source from
                        above its book root (pom.xml, include sources) to stay in
                        sync with the code. This is a trusted first-party build,
                        so allow-list the repo root explicitly rather than
                        disabling containment.
                    -->
                    <externalIncludeDirs>
                        <externalIncludeDir>${project.basedir}/..</externalIncludeDir>
                    </externalIncludeDirs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
