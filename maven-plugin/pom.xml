<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.noregressions.paperband</groupId>
        <artifactId>parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>paperband-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Paperband :: Maven Plugin</name>
    <description>Maven plugin front end for building Paperband PDFs as part of a Maven build.</description>
    <url>https://github.com/noregressions/paperband</url>

    <!--
        Named paperband-maven-plugin, not maven-plugin like the other short
        module artifactIds (core, cards, config...): Maven's default
        goal-prefix derivation strips a trailing "-maven-plugin" from the
        artifactId, so this resolves to the "paperband" prefix - i.e.
        `mvn paperband:build` - instead of deriving an empty/unusable
        prefix from a bare "maven-plugin" artifactId.
    -->

    <dependencies>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>render-playwright</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>cards</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>config</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>include</artifactId>
        </dependency>
        <!--
            PDF post-processing (watermark stamping) and page-span analysis
            (the `pages` goal, and `build`'s page-count enforcement) read and
            rewrite the finished PDF, which needs PDFBox directly - the
            renderer only ever writes one. Moved here with those classes when
            the CLI module was retired; see maven/pdf/PagesReport.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.noregressions.paperband</groupId>
            <artifactId>layout</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <build>
    <plugins>

    <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.8.0</version>

        <configuration>
            <updatePomFile>true</updatePomFile>
            <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>

        <executions>
            <execution>
                <id>flatten</id>
                <phase>process-resources</phase>
                <goals>
                    <goal>flatten</goal>
                </goals>
            </execution>

            <execution>
                <id>flatten.clean</id>
                <phase>clean</phase>
                <goals>
                    <goal>clean</goal>
                </goals>
            </execution>
        </executions>
    </plugin>
    </plugins>
    </build>

</project>
